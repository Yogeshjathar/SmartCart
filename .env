# ========================
# DATABASE (PostgreSQL)
# ========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartcart_db
POSTGRES_PORT=5432

# ========================
# DATABASE PER SERVICE
# ========================
USER_DB=user_db
INVENTORY_DB=inventory_db
ORDER_DB=order_db
PAYMENT_DB=payment_db

# MongoDB for services that use it
PRODUCT_DB=product_db
NOTIFICATION_DB=notification_db

# ========================
# MICROSERVICE DATASOURCES
# ========================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# ========================
# SERVICE PORTS
# ========================
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
PRODUCT_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084
ORDER_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
EUREKA_PORT=8761

# ========================
# MONGO PORTS
# ========================
MONGO_PORT=27017

# ========================
# REDIS
# ========================
REDIS_PORT=6379

# ========================
# KAFKA CONFIG
# ========================
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ========================
# Monitoring CONFIG
# ========================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
